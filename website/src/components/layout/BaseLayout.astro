---
import { ViewTransitions } from 'astro:transitions';
import '~/styles/global.css';

export interface Props {
  title: string;
  description?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  canonical?: string;
}

const { title, description, jsonLd, ogImage = '/og-default.png', canonical } = Astro.props;
const siteName = 'Synapse';
const fullTitle = title === siteName ? title : `${title} — ${siteName}`;
const desc = description ?? 'A tiny, annotation-driven pub/sub bus for FIRST Tech Challenge robot code.';
// Use only the path so this site is deployable on any host. Absolute
// URLs in canonical/og:url would be baked into the static HTML at
// build time and would hard-code whatever host the build was run on.
const path = canonical ?? Astro.url.pathname;
const ogImagePath = ogImage;
const ldArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={path} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={path} />
    <meta property="og:image" content={ogImagePath} />
    <meta property="og:site_name" content={siteName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImagePath} />
    {(() => {
      const p = Astro.url.pathname;
      // Only advertise a markdown mirror for paths with a real per-page .md
      // mirror under /docs/* — `src/pages/docs.md.ts` is the aggregate llms-full
      // endpoint, not a mirror of `/docs`, and `/docs/index.astro` has no MDX
      // counterpart either.
      const isDocs = p.startsWith('/docs/') && p !== '/docs/';
      return isDocs ? <link rel="alternate" type="text/markdown" href={`${p.replace(/\/$/, '')}.md`} /> : null;
    })()}
    <link
      rel="preconnect"
      href="https://rsms.me/"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource-variable/space-grotesk@5.0.20/index.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource-variable/jetbrains-mono@5.0.20/index.min.css"
    />

    <!-- FOUC-free theme boot: read localStorage before paint -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('synapse-theme');
          var theme = stored === 'light' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    {ldArray.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <ViewTransitions />
  </head>
  <body>
    <slot />
  </body>
</html>
