---
const code = `// One line. Every gamepad button + axis as topics.
GamepadAdaptor.attach(orchestrator, gamepad1, "g1");

// React to a rising edge from anywhere.
@SubscribedTo(topic = "g1/right_bumper/rising")
@OnHardwareThread
public void onPress(Boolean v) {
    intake.run(m -> m.setPower(1.0));
}`;
---
<section class="install-snippet reveal">
  <div class="install-snippet__head">
    <h2>One line to wire the gamepad</h2>
    <p>Reflects all boolean and float fields from com.qualcomm.robotcore.hardware.Gamepad onto topics.</p>
  </div>
  <div class="install-snippet__code">
    <pre><code>{code}</code></pre>
  </div>
  <p class="install-snippet__foot">
    See <a href="/docs/ftc/gamepad-adaptor">GamepadAdaptor</a> for the full topic map.
  </p>
</section>

<style>
  .install-snippet { padding: 4rem 1.5rem; max-width: 900px; margin: 0 auto; }
  .install-snippet__head { text-align: center; margin-bottom: 1.4rem; }
  .install-snippet__head h2 { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0; }
  .install-snippet__head p { color: var(--text-muted); margin-top: 0.5rem; }
  .install-snippet__code {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.2rem;
    overflow: auto;
  }
  .install-snippet__code pre { margin: 0; font-size: 0.95rem; }
  .install-snippet__foot { text-align: center; margin-top: 1rem; color: var(--text-muted); }
</style>
