---
const pillars = [
  {
    title: 'A single hardware thread',
    body: 'Every DcMotorEx, Servo, IMU, sensor read and write funnels through one OS thread. See OrchestratorImpl.java:93 — the dedicated executor that backs runOnHardwareThread and @OnHardwareThread dispatch.',
    file: 'OrchestratorImpl.java:93',
    test: 'HardwareThreadTest.java',
  },
  {
    title: 'Two-pool isolation',
    body: '@RunPeriodically loops run on the scheduler pool; @SubscribedTo callbacks run on the callback pool. A slow subscriber can never starve a periodic loop.',
    file: 'OrchestratorImpl.java:76-82',
    test: 'ThreadingTest.java:16, 50',
  },
  {
    title: 'Copy-on-write subscriber snapshots',
    body: 'SubscriberList.snapshot() returns a stable array under a lock. Publishers iterate without contention and subscribers can safely join/leave mid-dispatch.',
    file: 'OrchestratorImpl.java:538-576',
    test: 'SoakTest.java:32, 85, 121',
  },
  {
    title: 'Fail-fast thread assertion',
    body: 'SafeOpMode.loop() calls hardware.assertNotHardwareThread() before every tick. If you ever accidentally schedule the OpMode loop on the hardware thread, it throws.',
    file: 'SafeOpMode.java:62-66',
    test: 'HardwareActionsTest.java',
  },
];
---
<section class="pillars reveal">
  <header>
    <h2>Four safety properties, proven by tests</h2>
    <p>Not claims. Test names you can run.</p>
  </header>
  <ol role="list" class="pillars__list">
    {pillars.map((p, i) => (
      <li class="pillars__item">
        <span class="pillars__num">0{i + 1}</span>
        <div>
          <h3>{p.title}</h3>
          <p>{p.body}</p>
          <p class="pillars__cite">
            <code>{p.file}</code>
            <span aria-hidden="true">·</span>
            <span>Test: <code>{p.test}</code></span>
          </p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .pillars { padding: 5rem 1.5rem; background: var(--surface-1); border-block: 1px solid var(--border); }
  .pillars header { max-width: 760px; margin: 0 auto 2.5rem; text-align: center; }
  .pillars h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0; }
  .pillars header p { color: var(--text-muted); margin-top: 0.6rem; }
  .pillars__list { list-style: none; padding: 0; margin: 0; max-width: 900px; margin-inline: auto; display: grid; gap: 1.4rem; }
  .pillars__item { display: grid; grid-template-columns: 80px 1fr; gap: 1rem; align-items: start; }
  .pillars__num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: var(--signal-bright);
    line-height: 1;
  }
  .pillars__item h3 { margin: 0 0 0.4rem; font-size: 1.15rem; }
  .pillars__item p { color: var(--text-muted); margin: 0 0 0.6rem; line-height: 1.55; }
  .pillars__cite { font-size: 0.82rem; display: flex; gap: 0.5rem; align-items: center; }
  .pillars__cite code { color: var(--lime); }
</style>
