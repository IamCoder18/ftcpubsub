---
const boxes = [
  { label: 'OpMode thread', desc: 'runs loop(), publishes to topics', color: 'var(--signal)' },
  { label: 'Scheduler pool', desc: '@RunPeriodically loops (no hardware)', color: 'var(--signal-bright)' },
  { label: 'Callback pool', desc: '@SubscribedTo handlers (4–16 threads)', color: 'var(--signal-bright)' },
  { label: 'Action pool', desc: '@RunnableAction (unbounded)', color: 'var(--signal-bright)' },
  { label: 'Hardware thread', desc: 'the single dedicated thread for ALL hardware I/O', color: 'var(--lime)' },
];
---
<section class="arch">
  <header>
    <h2>The thread topology</h2>
    <p>Three pools, plus the OpMode and hardware threads. Everything you need on one page.</p>
  </header>
  <div class="arch__grid">
    {boxes.map((b) => (
      <div class="arch__box" style={`--c:${b.color}`}>
        <h3>{b.label}</h3>
        <p>{b.desc}</p>
      </div>
    ))}
  </div>
  <p class="arch__caption">
    See <a href="/docs/concepts/orchestrator">Orchestrator concepts</a> for the full rationale.
  </p>
</section>

<style>
  .arch { padding: 5rem 1.5rem; background: var(--surface-1); border-block: 1px solid var(--border); }
  .arch header { text-align: center; max-width: 720px; margin: 0 auto 2rem; }
  .arch h2 { font-size: clamp(1.8rem, 4vw, 2.6rem); margin: 0; }
  .arch header p { color: var(--text-muted); margin-top: 0.5rem; }
  .arch__grid {
    max-width: 900px;
    margin: 0 auto;
    display: grid;
    gap: 0.8rem;
  }
  .arch__box {
    background: var(--surface-2);
    border-left: 4px solid var(--c);
    border-radius: 8px;
    padding: 0.9rem 1.1rem;
  }
  .arch__box h3 { margin: 0; font-size: 1rem; color: var(--c); font-family: var(--font-display); }
  .arch__box p { margin: 0.2rem 0 0; color: var(--text-muted); font-size: 0.92rem; }
  .arch__caption { text-align: center; margin-top: 1.5rem; color: var(--text-muted); }
</style>
