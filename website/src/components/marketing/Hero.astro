---
import HeroCanvas from '~/components/react/HeroCanvas.tsx';
import CopyButton from '~/components/react/CopyButton.tsx';

const gradleSnippet = `dependencies {
    implementation 'com.aaravlabs:synapse:0.3.1'
}`;
---
<section class="hero">
  <div class="hero__canvas">
    <HeroCanvas client:visible />
  </div>
  <div class="hero__inner">
    <span class="syn-pill syn-pill--accent">v0.3.1 · MIT · 40 KB JAR</span>
    <h1>Robots that listen to each other.</h1>
    <p class="hero__sub">
      A tiny, annotation-driven pub/sub bus for FIRST Tech Challenge robot code. One hardware thread,
      type-checked topics, zero runtime dependencies.
    </p>
    <div class="hero__ctas">
      <a href="/docs" class="btn btn--primary">Read the docs →</a>
      <a href="/install" class="btn">Install for FTC</a>
    </div>
    <div class="hero__install">
      <pre><code>{gradleSnippet}</code></pre>
      <CopyButton client:load value={gradleSnippet} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding: 6rem 1.5rem 5rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.85;
  }
  .hero__inner {
    max-width: 880px;
    margin: 0 auto;
    text-align: center;
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 4rem);
    margin: 1.1rem 0 1rem;
    line-height: 1.05;
  }
  .hero__sub {
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0 auto 1.8rem;
    font-size: 1.1rem;
    line-height: 1.55;
  }
  .hero__ctas {
    display: flex;
    gap: 0.7rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1.1rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }
  .btn:hover { border-color: var(--signal-bright); color: var(--lime); }
  .btn--primary {
    background: var(--signal);
    border-color: var(--signal-bright);
    color: white;
  }
  .btn--primary:hover { background: var(--signal-bright); color: var(--surface-0); }
  .hero__install {
    max-width: 560px;
    margin: 0 auto;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.9rem 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-align: left;
  }
  .hero__install pre { margin: 0; overflow: auto; flex: 1; }
  .hero__install code { font-size: 0.9rem; }
  :global(.syn-copy) {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface-2);
    color: var(--text);
    cursor: pointer;
    font-size: 0.85rem;
  }
</style>
