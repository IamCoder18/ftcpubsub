---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import Nav from '~/components/layout/Nav.astro';
import Footer from '~/components/layout/Footer.astro';
import { loadChangelog } from '~/lib/changelog';

const releases = loadChangelog();

// Bullets are raw markdown lines. Escape HTML, then render the two inline
// constructs CHANGELOG.md actually uses: **bold** and `code`.
const inline = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/`([^`]+?)`/g, '<code>$1</code>');
---
<BaseLayout
  title="Changelog"
  description="Every release of Synapse, in Keep-a-Changelog format."
>
  <Nav />
  <main class="cl">
    <header class="cl__head">
      <h1>Changelog</h1>
      <p>All notable changes to Synapse, following <a href="https://keepachangelog.com" rel="noopener">Keep a Changelog</a>.</p>
    </header>
    {releases.map((rel) => (
      <article class={`cl__rel ${rel.isLatest ? 'cl__rel--latest' : ''}`}>
        <header>
          <h2>
            {rel.isUnreleased ? 'Unreleased' : `v${rel.version}`}
            {rel.isLatest && <span class="cl__pill">Latest</span>}
          </h2>
          {rel.date && <p class="cl__date">{rel.date}</p>}
        </header>
        {rel.sections.map((s) => (
          <section>
            <h3>{s.type[0].toUpperCase()}{s.type.slice(1)}</h3>
            <ul role="list">
              {s.bullets.map((b) => <li set:html={inline(b)} />)}
            </ul>
          </section>
        ))}
      </article>
    ))}
  </main>
  <Footer />
</BaseLayout>

<style>
  .cl { max-width: 820px; margin: 0 auto; padding: 3rem 1.5rem 5rem; }
  .cl__head { text-align: center; margin-bottom: 3rem; }
  .cl__head h1 { font-size: clamp(2.4rem, 6vw, 3.4rem); margin: 0; }
  .cl__head p { color: var(--muted-foreground); margin-top: 0.6rem; }
  .cl__head a { color: var(--primary); }
  .cl__rel { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem 1.8rem; margin-bottom: 1.5rem; }
  .cl__rel--latest { border-color: color-mix(in oklab, var(--primary) 45%, transparent); }
  .cl__pill {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5rem;
    padding: 0.15rem 0.65rem;
    border: 1px solid color-mix(in oklab, var(--primary) 40%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 10%, transparent);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    vertical-align: middle;
  }
  .cl__rel header { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.6rem; }
  .cl__rel h2 { font-size: 1.5rem; margin: 0; }
  .cl__date { color: var(--muted-foreground); margin: 0; font-family: var(--font-mono); font-size: 0.85rem; }
  .cl__rel h3 { font-size: 1rem; margin-top: 1.2rem; text-transform: capitalize; color: var(--primary); font-family: var(--font-display); }
  .cl__rel ul { padding-left: 1.2rem; }
  .cl__rel li { line-height: 1.6; color: var(--muted-foreground); }
  .cl__rel li strong { color: var(--foreground); }
  .cl__rel li code { font-family: var(--font-mono); font-size: 0.85em; background: var(--muted); padding: 0.1em 0.35em; border-radius: 4px; }
</style>
