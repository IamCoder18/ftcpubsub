---
import BaseLayout from '~/components/layout/BaseLayout.astro';
import Nav from '~/components/layout/Nav.astro';
import Footer from '~/components/layout/Footer.astro';
---
<BaseLayout title="Not found" description="That page doesn't exist.">
  <Nav />
  <main class="nf">
    <h1>404</h1>
    <p>That page doesn't exist. Try the <a href="/docs">docs</a> or the <a href="/">homepage</a>.</p>
  </main>
  <Footer />
</BaseLayout>

<style>
  .nf { text-align: center; padding: 5rem 1.5rem; max-width: 540px; margin: 0 auto; }
  .nf h1 { font-size: 5rem; margin: 0; }
  .nf a { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
</style>
